# X402 Payment Protocol Configuration
# Required for /secret route payment protection

# Your wallet address to receive payments (Ethereum address format)
RESOURCE_WALLET_ADDRESS=0xYourWalletAddressHere

# Network to use: "base-sepolia" for testnet, "base" for mainnet
X402_NETWORK=base-sepolia

# Optional: Custom facilitator URL (defaults to x402.org/facilitator for testnet)
# X402_FACILITATOR_URL=https://x402.org/facilitator
